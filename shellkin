# :command.initialize
initialize() {
  declare -g version="0.1.1"
  set -eo pipefail

  # :command.environment_variables_default
  export SHELLKIN_FEATURES_ROOT="${SHELLKIN_FEATURES_ROOT:-features}"
  export SHELLKIN_STEPDEFS_ROOT="${SHELLKIN_STEPDEFS_ROOT:-step_definitions}"

}

# :command.run
bashly_run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "test") shellkin_test_command ;;
    "validate") shellkin_validate_command ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then

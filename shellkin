# :command.run
bashly_run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "test") shellkin_test_command ;;
  esac
}

